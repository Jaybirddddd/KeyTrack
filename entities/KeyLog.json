{
  "name": "KeyLog",
  "type": "object",
  "properties": {
    "car_id": {
      "type": "string",
      "description": "Reference to the car"
    },
    "car_label": {
      "type": "string",
      "description": "Display label for the car (year make model)"
    },
    "stock_number": {
      "type": "string",
      "description": "Stock number of the car"
    },
    "action": {
      "type": "string",
      "enum": [
        "checked_out",
        "checked_in"
      ],
      "description": "Whether the key was checked out or returned"
    },
    "person": {
      "type": "string",
      "description": "Person who checked out or returned the key"
    },
    "reason": {
      "type": "string",
      "description": "Reason for checking out the key"
    }
  },
  "required": [
    "car_id",
    "action",
    "person"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}